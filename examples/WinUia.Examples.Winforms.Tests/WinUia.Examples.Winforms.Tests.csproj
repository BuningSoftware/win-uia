<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI tests of the example application (examples/WinUia.Examples.Winforms), written the way a WinUia user would:
    page objects over WinUia, one desktop per test with [UiTest].
  -->

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinUia\WinUia.csproj" />
    <ProjectReference Include="..\..\src\WinUia.NUnit\WinUia.NUnit.csproj" />
    <Using Include="WinUia.NUnit" />
    <Using Include="WinUia.NUnit.UiAssertions" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The application under test: built alongside the tests and launched by them; not referenced as an assembly. -->
    <ProjectReference Include="..\WinUia.Examples.Winforms\WinUia.Examples.Winforms.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ApplicationPath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\WinUia.Examples.Winforms\bin\$(Configuration)\$(TargetFramework)\WinUia.Examples.Winforms.exe'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation must run on MTA threads. -->
    <AssemblyAttribute Include="NUnit.Framework.ApartmentAttribute">
      <_Parameter1>System.Threading.ApartmentState.MTA</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
