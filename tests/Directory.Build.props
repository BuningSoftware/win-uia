<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) Or $(MSBuildProjectName.EndsWith('.Tests'))">true</IsUnitTestProject>
  </PropertyGroup>

  <!-- Settings shared by every test project (*.UnitTests and *.Tests). -->
  <ItemGroup Condition="'$(IsUnitTestProject)' == 'true'">
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />

    <Using Include="NUnit.Framework" />

    <!--
      [UiTest] gives each UI test the desktop to itself and Eventually(...) waits for asynchronous UI state, the way a
      WinUia package user would.
    -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\WinUia.NUnit\WinUia.NUnit.csproj" />
    <Using Include="WinUia.NUnit" />
    <Using Include="WinUia.NUnit.UiAssertions" Static="true" />

    <!--
      UI Automation must run on MTA threads; state it explicitly for every test assembly.
      NUnit runs tests sequentially unless [Parallelizable] is used, which UI tests (one desktop, one input
      queue) must not be.
    -->
    <AssemblyAttribute Include="NUnit.Framework.ApartmentAttribute">
      <_Parameter1>System.Threading.ApartmentState.MTA</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Test projects that launch the test app (tests/WinUia.TestApp, an empty window) reference WinUia.Testing.Shared themselves,
    which locates it. Projects that do not need the app do not build it. Tests never use anything from examples/.
  -->
</Project>
